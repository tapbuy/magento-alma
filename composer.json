{
    "name": "tapbuy/alma",
    "description": "Tapbuy Alma Payment for Magento 2 GraphQL",
    "type": "magento2-module",
    "version": "1.5.2",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-payment": "^100.4",
        "almapay/alma-monthlypayments-magento2": "^4.0 || ^5.0",
        "tapbuy/redirect-tracking": "^1.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Tapbuy\\Alma\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tapbuy\\Alma\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "@php -r \"echo 'Run `make test` to run PHPUnit via Docker (matches CI environment).\\n'; exit(1);\""
    }
}